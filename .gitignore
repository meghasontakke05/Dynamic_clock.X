# Ignore everything in nbproject
**/*.X/nbproject/*

# Keep essential project metadata
!**/*.X/nbproject/project.xml
!**/*.X/nbproject/configurations.xml

# Ignore private and generated files
**/*.X/nbproject/private/
**/*.X/nbproject/*.mk
**/*.X/nbproject/*.bash
**/*.X/nbproject/Makefile-genesis.properties
**/*.X/nbproject/Package-*.xml
